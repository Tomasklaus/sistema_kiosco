# =========================================================
# 1. SUPABASE (Base de datos y Autenticación)
# =========================================================
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Indispensable para que los webhooks de Mercado Pago y PayPal actualicen las suscripciones:
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL pública de tu aplicación (para redirecciones luego del pago y webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =========================================================
# 2. MERCADO PAGO (Suscripción Mensual ARS + Pago Único Llave en Mano)
# =========================================================
# Access Token de Producción o Prueba (crea suscripciones /preapproval y preferencias dinámicas)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Clave secreta del Webhook en tu panel de Desarrolladores de Mercado Pago (opcional en local, recomendada en prod)
MP_WEBHOOK_SECRET=tu-webhook-secret-mp

# (Opcional) Links directos de respaldo si no querés usar generación por API:
# NEXT_PUBLIC_MP_SUBSCRIPTION_URL=https://www.mercadopago.com.ar/subscriptions/checkout?preapproval_plan_id=XXX
# NEXT_PUBLIC_MP_LLAVE_EN_MANO_URL=https://mpago.la/XXXXXXX

# =========================================================
# 3. PAYPAL (Suscripción Internacional USD + Pago Único Llave en Mano)
# =========================================================
PAYPAL_CLIENT_ID=tu-paypal-client-id
PAYPAL_CLIENT_SECRET=tu-paypal-client-secret
# 'sandbox' para pruebas o 'live' para producción
PAYPAL_ENV=sandbox
# (Opcional) ID de un Plan de Suscripción mensual en PayPal. Si se omite, crea una Orden de cobro por $20 USD automáticamente:
PAYPAL_PLAN_ID=P-XXXXXXXXXXXXXXXXXXXXXXXX
# (Opcional) ID del Webhook configurado en developer.paypal.com para verificar firmas:
PAYPAL_WEBHOOK_ID=tu-paypal-webhook-id

# =========================================================
# 4. COMERCIAL / WHATSAPP ("Servicio Llave en Mano")
# =========================================================
# Número en formato internacional sin "+" ni espacios (ej: 5492664000000)
NEXT_PUBLIC_WHATSAPP_COMERCIAL=5492664000000
